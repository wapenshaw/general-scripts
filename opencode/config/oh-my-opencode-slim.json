                            "variant": "xhigh"
                        },
                        {
                            "id": "opencode-go/minimax-m3",
                            "variant": "thinking"
                        }
                    ],
                    "prompt": "Focus on correctness: bugs, edge cases, race conditions, error handling, and unhandled failure modes in application and script code."
                },
                "architect": {
                    "model": [
                        {
                            "id": "xai/grok-4.6",
							"variant": "high"
                        },
                        {
                            "id": "opencode-go/glm-5.3",
                            "variant": "high"
                        }
                    ],
                    "prompt": "Focus on software design: module boundaries, coupling and cohesion, API contracts, dependency direction, migration risk, and long-term maintainability."
                },
                "cloud": {
                    "model": [
                        {
                            "id": "opencode-go/glm-5.3",
                            "variant": "high"
                        },
                        {
                            "id": "xai/grok-4.6",
							"variant": "high"
                        }
                    ],
                    "prompt": "Focus on cloud and infrastructure: networking, deployment topology, scalability and failure domains, infrastructure-as-code and configuration management, operability, and cost efficiency."
                },
                "optimizer": {
                    "model": [
                        {
                            "id": "opencode-go/minimax-m3",
                            "variant": "thinking"
                        },
                        {
                            "id": "opencode-go/hy3",
                            "variant": "high"
                        }
                    ],
                    "prompt": "Focus on performance: latency, throughput, memory and resource usage, startup cost, and redundant work. Quantify trade-offs before recommending changes."
                }
            }
        },
        "default_preset": "swe-cloud"
    },
    "companion": {
        "enabled": false,
