{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "layout": "auto",
  "plugin": [
    "opencode-antigravity-auth@latest",
    "opencode-mem",
    "@tarquinen/opencode-dcp@latest",
    "@slkiser/opencode-quota@latest",
    "oh-my-opencode-slim"
  ],
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "lsp": true,
  "snapshot": true,
  "formatter": true,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 2000
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/archive/**",
      "**/*.log"
    ]
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1920,
      "max_height": 1080,
      "max_base64_bytes": 5242880
    }
  },
  "command": {},
  "permission": "allow",
  "provider": {
    "opencode-go": {},
    "opencode": {
      "models": {
        "deepseek-v4-flash-free": {
          "options": {
            "reasoningEffort": "max"
          }
        }
      }
    },
    "google": {
      "options": {
        "websearch_cited": {
          "model": "gemini-3.5-flash",
          "projectId": "gen-lang-client-0968106005"
        }
      }
    },
    "xai": {}
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
