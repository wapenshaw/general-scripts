# Auto Title configuration.
# Every line below is the default unless uncommented/changed.

# Log at DEBUG rather than INFO.
#HERDR_AUTO_TITLE_DEBUG=false

# How often the session is read, in milliseconds.
#HERDR_AUTO_TITLE_POLL_MS=500

# Longest title, in columns of the tab bar.
#HERDR_AUTO_TITLE_MAX_LENGTH=50

# Longest branch name a title may carry, in columns. 0 leaves branches out.
HERDR_AUTO_TITLE_BRANCH_MAX=0

# Put each tab's position in front of its title.
HERDR_AUTO_TITLE_POSITION=false

# Where tabs you renamed by hand are remembered.
#HERDR_AUTO_TITLE_MANUAL_FILE=/Users/siddharth/Library/Application Support/herdr-auto-title/manual-names.json

# Read an agent's own session transcript when it has not titled its terminal.
#HERDR_AUTO_TITLE_TRANSCRIPT=true

# Put the agent's name in front of what an agent pane is doing.
#HERDR_AUTO_TITLE_AGENT_NAME=true

# Name each pane as well as its tab.
#HERDR_AUTO_TITLE_PANES=true

# Name a tab after the pane running an agent even while another pane in it is focused.
#HERDR_AUTO_TITLE_PREFER_AGENT=false

# Name a workspace holding exactly one tab after that tab.
#HERDR_AUTO_TITLE_WORKSPACES=false

# Longest workspace label, in columns.
#HERDR_AUTO_TITLE_WORKSPACE_MAX_LENGTH=20

# Other Claude Code configuration directories.
#HERDR_AUTO_TITLE_CLAUDE_DIRS=
