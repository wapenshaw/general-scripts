{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "5",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "CLAUDE_CODE_PROMPT_CACHE_TTL": "1h",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "5m",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0",
    "BASH_MAX_OUTPUT_LENGTH": "12000",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "KEEPWARM_INTERVAL_MIN": "50",
    "KEEPWARM_TTL_MIN": "60",
    "KEEPWARM_MAX_BUMPS": "4",
    "KEEPWARM_MIN_CONTEXT_TOKENS": "100000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "/home/heaton/.claude/hooks/destructive-guard.sh"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/heaton/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.js",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "microsoft-docs@claude-plugins-official": true,
    "keepwarm@keepwarm": true
  },
  "extraKnownMarketplaces": {
    "keepwarm": {
      "source": {
        "source": "github",
        "repo": "Delitefully/claude-keepwarm"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "default",
  "timeFormat": "24-hour",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": true,
  "preferredNotifChannel": "auto",
  "useAutoModeDuringPlan": true
}
