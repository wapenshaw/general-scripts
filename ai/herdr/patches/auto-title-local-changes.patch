+	p.write(expanded(strings.Repeat("x", maxScan+1)), customTitle("Branch cleanup"))
+
+	if got := p.reader().Topic(session, started); got.Text() != "Branch cleanup" {
+		t.Errorf("topic = %+v, want the custom title in the transcript tail", got)
+	}
+}
