+func TestCustomTitlesNameASession(t *testing.T) {
+	t.Parallel()
+
+	for _, test := range []struct {
+		name  string
+		lines []string
+		want  string
+	}{
+		{"custom title", []string{human("fix the redirect"), customTitle("Branch cleanup")}, "Branch cleanup"},
+		{"renamed title", []string{aiTitle("First guess"), customTitle("Branch cleanup"), customTitle("GitHub cleanup")}, "GitHub cleanup"},
+		{"later generated title", []string{customTitle("Branch cleanup"), aiTitle("OAuth redirect fix")}, "OAuth redirect fix"},
+		{"empty custom title", []string{customTitle("Branch cleanup"), customTitle("")}, "Branch cleanup"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			p := newProject(t)
+			p.write(test.lines...)
+
+			if got := p.reader().Topic(session, started); got.Text() != test.want {
+				t.Errorf("topic = %+v, want %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestAppendedCustomTitleIsReadOnTheNextPoll(t *testing.T) {
+	t.Parallel()
+
+	p := newProject(t)
+	p.write(aiTitle("First guess"))
+	reader := p.reader()
+	reader.Topic(session, started)
+	p.appendLines(customTitle("Branch cleanup"))
+
+	if got := reader.Topic(session, started); got.Text() != "Branch cleanup" {
+		t.Errorf("topic = %+v, want the appended custom title", got)
+	}
+}
+
+func TestCustomTitleIsReadFromALargeTranscriptsTail(t *testing.T) {
+	t.Parallel()
+
