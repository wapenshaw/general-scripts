{
  "$schema": "https://opencode.ai/tui.json",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "mouse": true,
  "theme": "aura",
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.8
  },
  "keybinds": {
    "agent_cycle": "shift+tab",
    "agent_cycle_reverse": "none"
  },
  "plugin": [
    "@slkiser/opencode-quota@latest",
    "@mrgray17/opentoken@latest",
    "@tarquinen/opencode-dcp@latest",
    "oh-my-opencode-slim"
  ]
}
